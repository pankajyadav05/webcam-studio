<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Camera extensions must run in the app sandbox. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Must match the start of CMIOExtensionMachServiceName in Info.plist. The team ID
	     prefix is filled in at signing time. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)dev.pankajyadav.webcamstudio</string>
	</array>
</dict>
</plist>
