<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets the app install the camera extension. This is a restricted entitlement: it
	     only works with a Developer ID signature and a matching provisioning profile. -->
	<key>com.apple.developer.system-extension.install</key>
	<true/>
	<!-- Camera and microphone access under the hardened runtime. The host app is not
	     sandboxed. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
