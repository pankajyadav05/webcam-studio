{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Webcam Studio",
  "identifier": "dev.pankajyadav.webcamstudio",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Webcam Studio",
        "width": 1120,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 28
        },
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; img-src 'self' data: blob:; media-src 'self' blob: mediastream:; connect-src 'self' ipc: http://ipc.localhost",
      "capabilities": [
        "default",
        {
          "identifier": "window-toolbar",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:window:allow-start-dragging"
          ]
        }
      ]
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Webcam and microphone studio",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "macos/WebcamStudio.entitlements",
      "minimumSystemVersion": "14.0",
      "files": {
        "Resources/Assets.car": "icons/macos/Assets.car"
      }
    },
    "resources": {
      "icons/source/Credits.html": "Credits.html"
    }
  }
}
